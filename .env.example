# === MIT Medical Tower CRM ===

# Server
PORT=8443
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://crm_medtower:PASSWORD@db:5432/crm_medtower
DB_SSL=false

# Session & Security
SESSION_SECRET=GENERATE_WITH_NODE_CRYPTO
ENCRYPTION_KEY=GENERATE_WITH_NODE_CRYPTO

# Brand
BRAND_NAME=MIT Medical Tower
BRAND_TIMEZONE=America/Mexico_City
BRAND_COUNTRY=MX
BRAND_CURRENCY=MXN
BRAND_PHONE_DISPLAY=+52 55 2838 0715

# Feature Flags
FEATURE_WHATSAPP=true
FEATURE_BOT=true
FEATURE_PARRILLA=false
FEATURE_INSTAGRAM=false
FEATURE_KPIS=true
FEATURE_MULTI_VENDEDOR=true
FEATURE_CRON_SEGUIMIENTO=true

# WhatsApp Accounts (id:label pairs, comma-separated)
WHATSAPP_ACCOUNTS=principal:Línea Principal

# Cron
CRON_API_KEY=GENERATE_WITH_NODE_CRYPTO

# Team Notification Recipients (Name:Phone pairs)
CRM_TEAM_RECIPIENTS=Admin:525528380715

# SSL (for direct HTTPS termination)
SSL_CERT_PATH=
SSL_KEY_PATH=
